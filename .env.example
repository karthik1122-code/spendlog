MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/spendlog
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Password-reset email through Resend. Without a key, reset links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="SpendLog <no-reply@yourdomain.com>"
# Public URL used in reset links, e.g. https://spendlog.onrender.com
APP_URL=
